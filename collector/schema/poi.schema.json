{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A1 TIC POI",
  "type": "object",
  "required": [
    "poi_id",
    "canonical_name",
    "category",
    "status",
    "evidence"
  ],
  "properties": {
    "poi_id": {
      "type": "string"
    },
    "canonical_name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "lat": {
      "type": [
        "number",
        "null"
      ]
    },
    "lng": {
      "type": [
        "number",
        "null"
      ]
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "province": {
      "type": [
        "string",
        "null"
      ]
    },
    "locality": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "VERIFIED",
        "CONFLICT",
        "STALE",
        "CLOSED"
      ]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "freshness_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}